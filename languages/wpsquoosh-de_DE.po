msgstr "Größere Datei erlauben (nicht empfohlen)"

#: admin/views/page-batch.php
msgid "Advanced mode (risky)"
msgstr "Erweiterter Modus (riskant)"

#: admin/views/page-batch.php
msgid "Changing format or dimensions can break the site (themes, CSS, hardcoded URLs). Use only if you know what you are doing."
msgstr "Format- oder Größenänderungen können die Website beschädigen (Themes, CSS, URLs). Nur verwenden, wenn Sie wissen, was Sie tun."

#: admin/views/page-batch.php
msgid "Enable advanced mode for this job"
msgstr "Erweiterten Modus für diesen Auftrag aktivieren"

#: admin/views/page-batch.php
msgid "Max width (0 = keep)"
msgstr "Max. Breite (0 = behalten)"

#: admin/views/page-batch.php
msgid "Max height (0 = keep)"
msgstr "Max. Höhe (0 = behalten)"

#: admin/views/page-batch.php
msgid "Convert to"
msgstr "Konvertieren nach"

#: admin/views/page-batch.php
msgid "None (keep format)"
msgstr "Keines (Format behalten)"

