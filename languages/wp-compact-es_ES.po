msgstr "wp-compact: %s no reemplazado (sin ahorro, %s)."

#: admin/class-admin-page.php
msgid "wp-compact: %1$s skipped (savings %2$s%% < %3$s%%)."
msgstr "wp-compact: %1$s omitido (ahorro %2$s%% < %3$s%%)."

#: admin/class-admin-page.php
msgid "wp-compact: %1$s %2$s%3$s → %4$s (−%5$s%%)."
msgstr "wp-compact: %1$s %2$s%3$s → %4$s (−%5$s%%)."

