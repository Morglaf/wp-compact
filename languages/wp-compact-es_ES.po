#: admin/class-admin-page.php
msgid "wp-compact"
msgstr "wp-compact"

#: admin/class-admin-page.php
msgid "Compress (wp-compact)"
msgstr "Comprimir (wp-compact)"

#: admin/class-admin-page.php
msgid "Advanced mode can change format or dimensions and break themes / CSS / hardcoded URLs."
msgstr "El modo avanzado puede cambiar el formato o las dimensiones y romper temas / CSS / URLs fijas."

