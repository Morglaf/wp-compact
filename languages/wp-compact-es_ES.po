#: admin/views/page-batch.php
msgid "wp-compact — Image compression"
msgstr "wp-compact — Compresión de imágenes"

#: admin/views/page-batch.php
msgid "Compression runs in your browser (WebAssembly). Images are not sent to a third-party server."
msgstr "La compresión se ejecuta en su navegador (WebAssembly). Las imágenes no se envían a un servidor de terceros."

#: admin/views/page-batch.php
msgid "Settings (safe mode)"
msgstr "Ajustes (modo seguro)"

#: admin/views/page-batch.php
msgid "JPEG quality"
msgstr "Calidad JPEG"

#: admin/views/page-batch.php
msgid "WebP quality"
msgstr "Calidad WebP"

#: admin/views/page-batch.php
msgid "Oxipng level (0–6)"
msgstr "Nivel Oxipng (0–6)"

#: admin/views/page-batch.php
msgid "Minimum savings (%)"
msgstr "Ahorro mínimo (%)"

#: admin/views/page-batch.php
msgid "Concurrency"
msgstr "Concurrencia"

#: admin/views/page-batch.php
msgid "Create a backup before replacing"
msgstr "Crear una copia de seguridad antes de reemplazar"

#: admin/views/page-batch.php
msgid "On image upload"
msgstr "Al subir imágenes"

#: admin/views/page-batch.php
msgid "Disabled"
msgstr "Desactivado"

#: admin/views/page-batch.php
msgid "Compress only (same format)"
msgstr "Solo comprimir (mismo formato)"

#: admin/views/page-batch.php
msgid "Convert to WebP"
msgstr "Convertir a WebP"

#: admin/views/page-batch.php
msgid "Allow a larger file (not recommended)"
msgstr "Permitir un archivo más grande (no recomendado)"

#: admin/views/page-batch.php
msgid "Advanced mode (risky)"
msgstr "Modo avanzado (arriesgado)"

#: admin/views/page-batch.php
msgid "Changing format or dimensions can break the site (themes, CSS, hardcoded URLs). Use only if you know what you are doing."
msgstr "Cambiar el formato o las dimensiones puede romper el sitio (temas, CSS, URLs). Úselo solo si sabe lo que hace."

#: admin/views/page-batch.php
msgid "Enable advanced mode for this job"
msgstr "Activar el modo avanzado para este trabajo"

#: admin/views/page-batch.php
msgid "Max width (0 = keep)"
msgstr "Ancho máx. (0 = mantener)"

#: admin/views/page-batch.php
msgid "Max height (0 = keep)"
msgstr "Alto máx. (0 = mantener)"

#: admin/views/page-batch.php
msgid "Convert to"
msgstr "Convertir a"

#: admin/views/page-batch.php
msgid "None (keep format)"
msgstr "Ninguno (mantener formato)"

#: admin/views/page-batch.php
msgid "AVIF quality (0–63 legacy → mapped to %)"
msgstr "Calidad AVIF (0–63 legacy → mapeado a %)"

#: admin/views/page-batch.php
msgid "Save settings"
msgstr "Guardar ajustes"

#: admin/views/page-batch.php
msgid "Compress entire Media Library"
msgstr "Comprimir toda la biblioteca de medios"

#: admin/views/page-batch.php
msgid "Migrate to WebP + update links"
msgstr "Migrar a WebP + actualizar enlaces"

#: admin/views/page-batch.php
msgid "Stop"
msgstr "Detener"

#: admin/views/page-batch.php
msgid "Migration converts to WebP, rewrites URLs in the database, and keeps previous files tagged for later cleanup."
msgstr "La migración convierte a WebP, reescribe las URLs en la base de datos y conserva los archivos anteriores etiquetados para una limpieza posterior."

#: admin/views/page-batch.php
msgid "Progress"
msgstr "Progreso"

#: admin/views/page-batch.php
msgid "Legacy file cleanup"
msgstr "Limpieza de archivos legacy"

#: admin/views/page-batch.php
msgid "After a WebP migration, previous JPG/PNG files (and thumbnails) remain on disk. Review the site, then purge them here."
msgstr "Tras una migración WebP, los JPG/PNG anteriores (y miniaturas) permanecen en el disco. Revise el sitio y luego purgue aquí."

#: admin/views/page-batch.php
msgid "Refresh"
msgstr "Actualizar"

#: admin/views/page-batch.php
msgid "Delete selected"
msgstr "Eliminar selección"

#: admin/views/page-batch.php
msgid "Purge all"
msgstr "Purgar todo"

#: admin/views/page-batch.php
msgid "ID"
msgstr "ID"

#: admin/views/page-batch.php
msgid "Title"
msgstr "Título"

#: admin/views/page-batch.php
msgid "Files"
msgstr "Archivos"

#: admin/views/page-batch.php
msgid "Size"
msgstr "Tamaño"

#: admin/views/page-batch.php
msgid "Loading…"
msgstr "Cargando…"

