msgstr "Adjunto no válido."

#: includes/class-rest.php
msgid "You are not allowed to edit this attachment."
msgstr "No tiene permiso para editar este adjunto."

#: includes/class-rest.php
msgid "No IDs provided."
msgstr "No se proporcionaron IDs."

#: includes/class-rest.php
msgid "Unable to read the file."
msgstr "No se puede leer el archivo."

#: includes/class-rest.php
msgid "Missing file parameter."
msgstr "Falta el parámetro file."

#: includes/class-rest.php
msgid "File too large."
msgstr "Archivo demasiado grande."

#: includes/class-rest.php
msgid "WebP migration requires administrator privileges."
msgstr "La migración WebP requiere privilegios de administrador."
